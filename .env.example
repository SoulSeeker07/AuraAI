# Example environment variables for Aura (copy to .env and edit)
AURA_SERVICE_HOST=127.0.0.1
AURA_SERVICE_PORT=8765
AURA_LOG_LEVEL=INFO
AURA_ENV=development

# API keys (if/when used)
OPENAI_API_KEY=
GROQ_API_KEY=
AURA_AI_PROVIDER=groq
AURA_GROQ_MODEL=openai/gpt-oss-120b
AURA_GROQ_VISION_MODEL=qwen/qwen3.6-27b
AURA_WEB_SEARCH_ENABLED=true
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
OLLAMA_API_KEY=
