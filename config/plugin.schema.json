{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuraPluginManifest",
  "type": "object",
  "required": ["name", "version", "capabilities"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier of the plugin"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
