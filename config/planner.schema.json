{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuraPlannerManifest",
  "type": "object",
  "required": ["planner", "handles"],
  "properties": {
    "planner": {
      "type": "string",
      "description": "Unique planner name"
    },
    "handles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capability patterns handled by this planner"
    },
    "priority": {
      "type": "integer",
      "default": 50
    },
    "parallel": {
      "type": "boolean",
      "default": false
    }
  }
}
